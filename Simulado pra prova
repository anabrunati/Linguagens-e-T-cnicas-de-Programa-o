  //ex2
  float valor, quantidade, preco, VPA, PVP;
  printf ("\nDigite o valor patrimonial da empresa: ");
  scanf ("%f", &valor);
  printf ("Digite a quantidade de acoes: ");
  scanf ("%f", &quantidade);
  printf ("Digite o preco atual da acao: ");
  scanf ("%f", &preco);
  
  VPA = valor / quantidade;
  PVP = preco / VPA;
  printf ("\nVPA: %2.f", VPA);
  printf ("\nP/VPA: %2.f", PVP);
  
  if (PVP <0.0) {
  	printf ("\nA classificacao: pessima");
  }
  else if (PVP <0.8) {
  	printf ("\nA classificacao: otima");
  }
  else if (PVP <=1.2) {
  	printf ("\nA classificacao: indiferente");
  }
  else if (PVP <=2.0) {
  	printf ("\nA classificacao: boa");
  }
  else {
  	printf ("\nClassificacao ruim");
  }
	return 0;
