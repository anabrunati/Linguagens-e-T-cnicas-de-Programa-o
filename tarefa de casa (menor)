#include <stdio.h>
#include <stdlib.h>

int comparaMenor (int a, int b){
    if (a < b) return a;
    else return b;
}

int main(int argc, char *argv[]) {
int valores[10];
int i, menor;

printf ("Vamos ler os valores: \n");
for (i=0; i<10; i++){
      scanf ("%d", &valores[i]);
    }

for (i=1, menor = valores[0]; i<5; i+=2){
        int temp = comparaMenor(valores[i], valores[i+1]);
        menor = comparaMenor(menor, temp);
    }

printf ("\n %d", menor);

return 0;
}
